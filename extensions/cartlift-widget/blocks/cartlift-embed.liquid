{%- comment -%}
  App embed: turns CartLift on for the whole theme and auto-places the deal
  widget above the add-to-cart button on product pages. If the merchant adds
  the "CartLift deals" app block, the widget renders there instead.
  On every page it also loads the cart watcher that keeps free gifts in step
  with the cart.
{%- endcomment -%}
{%- if request.page_type == 'product' and product -%}
  {%- render 'cartlift-data', product: product, placement: 'auto' -%}
{%- endif -%}
{%- render 'cartlift-cart', product: product -%}

{% schema %}
{
  "name": "CartLift deals",
  "target": "body",
  "settings": []
}
{% endschema %}
