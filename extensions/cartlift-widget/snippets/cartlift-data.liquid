{%- comment -%}
  Everything the widget needs, inlined so rendering needs no network call.
  `app.metafields.cartlift.deals` is published by the app (app/lib/sync.server.ts).
  `options` carries the option-value swatches (colour / image) for swatch pickers;
  `mf` the product metafields that deals use as text variables.
{%- endcomment -%}
{%- assign cl_config = app.metafields.cartlift.deals.value -%}
{%- if cl_config and product -%}
<script type="application/json" data-cartlift-data="{{ product.id }}">
  {
    "config": {{ cl_config | json }},
    "product": {{ product | json }},
    "collections": [{%- for c in product.collections -%}{{ c.id }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    "options": [
      {%- for option in product.options_with_values -%}
        {"name": {{ option.name | json }}, "values": [
          {%- for value in option.values -%}
            {"name": {{ value.name | json }},
             "color": {%- if value.swatch.color -%}{{ value.swatch.color | append: '' | json }}{%- else -%}null{%- endif -%},
             "image": {%- if value.swatch.image -%}{{ value.swatch.image | image_url: width: 96 | json }}{%- else -%}null{%- endif -%}}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "mf": {
      {%- for m in cl_config.mf -%}
        {{ m.k | json }}: {{ product.metafields[m.ns][m.key].value | json }}
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    },
    "moneyFormat": {{ shop.money_format | json }},
    "shop": {{ shop.permanent_domain | json }},
    "placement": {{ placement | json }}
  }
</script>
{{ 'cartlift.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cartlift.js' | asset_url }}" defer></script>
{%- endif -%}
